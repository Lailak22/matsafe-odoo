<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_matsafe_root" name="MatSafe" sequence="50"
              groups="matsafe.group_coach"/>

    <!-- Dashboard -->
    <menuitem id="menu_matsafe_dashboard" name="Dashboard" parent="menu_matsafe_root" sequence="10"/>
    <menuitem id="menu_matsafe_dashboard_reports" name="Reports per Week"
              parent="menu_matsafe_dashboard" action="action_matsafe_dashboard" sequence="1"/>
    <menuitem id="menu_matsafe_dashboard_checkins" name="Check-ins per Day"
              parent="menu_matsafe_dashboard" action="action_matsafe_dashboard_checkin" sequence="2"/>
    <menuitem id="menu_matsafe_dashboard_gear" name="Gear by State"
              parent="menu_matsafe_dashboard" action="action_matsafe_dashboard_gear" sequence="3"/>
    <menuitem id="menu_matsafe_dashboard_members" name="Members by State"
              parent="menu_matsafe_dashboard" action="action_matsafe_dashboard_members" sequence="4"/>

    <menuitem id="menu_matsafe_classes" name="Classes" parent="menu_matsafe_root"
              action="action_matsafe_session" sequence="20"/>
    <menuitem id="menu_matsafe_members" name="Members" parent="menu_matsafe_root"
              action="action_matsafe_members" sequence="30"/>
    <menuitem id="menu_matsafe_ratings" name="Ratings" parent="menu_matsafe_root"
              action="action_matsafe_rating" sequence="35"/>
    <menuitem id="menu_matsafe_reports" name="Reports" parent="menu_matsafe_root"
              action="action_matsafe_report" sequence="40"/>
    <menuitem id="menu_matsafe_outbreaks" name="Outbreaks" parent="menu_matsafe_root"
              action="action_matsafe_cluster" sequence="50"/>
    <menuitem id="menu_matsafe_door_log" name="Door Log" parent="menu_matsafe_root"
              action="action_matsafe_checkin" sequence="60"/>
    <menuitem id="menu_matsafe_gear" name="Gear" parent="menu_matsafe_root"
              action="action_matsafe_gear" sequence="70"/>

    <!-- Inbox: tasks created by the website form -->
    <menuitem id="menu_matsafe_inbox" name="Inbox" parent="menu_matsafe_root" sequence="45"/>
    <menuitem id="menu_matsafe_coach_inbox" name="Coach Inbox" parent="menu_matsafe_inbox"
              action="action_matsafe_coach_inbox" sequence="1" groups="matsafe.group_head_coach"/>
    <menuitem id="menu_matsafe_facility_issues" name="Facility Issues" parent="menu_matsafe_inbox"
              action="action_matsafe_facility_issues" sequence="2"/>

    <!-- Member pages: open the website pages from inside the app (new tab) -->
    <record id="action_open_report_page" model="ir.actions.act_url">
        <field name="name">Report form</field>
        <field name="url">/matsafe/report</field>
        <field name="target">new</field>
    </record>
    <record id="action_open_rate_page" model="ir.actions.act_url">
        <field name="name">Rate partners</field>
        <field name="url">/matsafe/rate</field>
        <field name="target">new</field>
    </record>
    <record id="action_open_kiosk_page" model="ir.actions.act_url">
        <field name="name">Door kiosk</field>
        <field name="url">/matsafe/kiosk</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_matsafe_pages" name="Member Pages" parent="menu_matsafe_root" sequence="80"/>
    <menuitem id="menu_matsafe_page_report" name="Report Form" parent="menu_matsafe_pages"
              action="action_open_report_page" sequence="1"/>
    <menuitem id="menu_matsafe_page_rate" name="Rate Partners" parent="menu_matsafe_pages"
              action="action_open_rate_page" sequence="2"/>
    <menuitem id="menu_matsafe_page_kiosk" name="Door Kiosk" parent="menu_matsafe_pages"
              action="action_open_kiosk_page" sequence="3"/>

    <!-- Operations (head coaches): pairing history, cleaning jobs, automatic checks -->
    <menuitem id="menu_matsafe_settings" name="Operations" parent="menu_matsafe_root" sequence="90"
              groups="matsafe.group_head_coach"/>
    <menuitem id="menu_matsafe_settings_pairings" name="Pairings"
              parent="menu_matsafe_settings" action="action_matsafe_pairing" sequence="1"/>
    <menuitem id="menu_matsafe_settings_cleaning" name="Mat Cleaning Tasks"
              parent="menu_matsafe_settings" action="action_matsafe_cleaning_tasks" sequence="2"/>
    <menuitem id="menu_matsafe_settings_crons" name="Scheduled Actions"
              parent="menu_matsafe_settings" action="base.ir_cron_act" sequence="3"
              groups="base.group_system"/>
</odoo>
