<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_matsafe_session_list" model="ir.ui.view">
        <field name="name">matsafe.session.list</field>
        <field name="model">matsafe.session</field>
        <field name="arch" type="xml">
            <list string="Classes" default_order="start desc">
                <field name="name"/>
                <field name="start"/>
                <field name="discipline"/>
                <field name="mat_zone"/>
                <field name="coach_id"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'running'"
                       decoration-info="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_matsafe_session_form" model="ir.ui.view">
        <field name="name">matsafe.session.form</field>
        <field name="model">matsafe.session</field>
        <field name="arch" type="xml">
            <form string="Class">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_make_pairs" type="object" string="Make Pairs" class="btn-primary"
                            invisible="state != 'running'"/>
                    <button name="action_end" type="object" string="End"
                            invisible="state != 'running'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. No-Gi Mon 19:00"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="start"/>
                            <field name="coach_id"/>
                        </group>
                        <group>
                            <field name="discipline"/>
                            <field name="mat_zone"/>
                            <field name="cleaning_task_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attendees" name="attendees">
                            <field name="attendee_ids" widget="many2many_tags"
                                   domain="[('is_member', '=', True)]"/>
                        </page>
                        <page string="Pairings" name="pairings">
                            <field name="pairing_ids">
                                <list editable="bottom">
                                    <field name="member_a_id" domain="[('is_member', '=', True)]"/>
                                    <field name="member_b_id" domain="[('is_member', '=', True)]"/>
                                    <field name="source"/>
                                    <field name="date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_matsafe_session_calendar" model="ir.ui.view">
        <field name="name">matsafe.session.calendar</field>
        <field name="model">matsafe.session</field>
        <field name="arch" type="xml">
            <calendar string="Classes" date_start="start" color="coach_id" mode="week">
                <field name="name"/>
                <field name="mat_zone"/>
                <field name="discipline"/>
            </calendar>
        </field>
    </record>

    <record id="view_matsafe_session_search" model="ir.ui.view">
        <field name="name">matsafe.session.search</field>
        <field name="model">matsafe.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="coach_id"/>
                <filter name="filter_running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="group_mat" string="Mat" context="{'group_by': 'mat_zone'}"/>
                <filter name="group_discipline" string="Discipline" context="{'group_by': 'discipline'}"/>
            </search>
        </field>
    </record>

    <record id="action_matsafe_session" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">matsafe.session</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <!-- Pairings (standalone list) -->
    <record id="view_matsafe_pairing_list" model="ir.ui.view">
        <field name="name">matsafe.pairing.list</field>
        <field name="model">matsafe.pairing</field>
        <field name="arch" type="xml">
            <list string="Pairings" default_order="date desc">
                <field name="date"/>
                <field name="session_id"/>
                <field name="member_a_id"/>
                <field name="member_b_id"/>
                <field name="source" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_matsafe_pairing" model="ir.actions.act_window">
        <field name="name">Pairings</field>
        <field name="res_model">matsafe.pairing</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
