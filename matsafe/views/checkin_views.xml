<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_matsafe_checkin_list" model="ir.ui.view">
        <field name="name">matsafe.checkin.list</field>
        <field name="model">matsafe.checkin</field>
        <field name="arch" type="xml">
            <list string="Door Log" default_order="datetime desc" create="false"
                  decoration-success="result == 'allowed'"
                  decoration-danger="result == 'blocked'">
                <field name="datetime"/>
                <field name="member_id"/>
                <field name="method"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'allowed'"
                       decoration-danger="result == 'blocked'"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_matsafe_checkin_search" model="ir.ui.view">
        <field name="name">matsafe.checkin.search</field>
        <field name="model">matsafe.checkin</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id"/>
                <filter string="Allowed" name="allowed" domain="[('result', '=', 'allowed')]"/>
                <filter string="Blocked" name="blocked" domain="[('result', '=', 'blocked')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter string="Member" name="group_member" context="{'group_by': 'member_id'}"/>
                <filter string="Day" name="group_day" context="{'group_by': 'datetime:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_matsafe_checkin" model="ir.actions.act_window">
        <field name="name">Door Log</field>
        <field name="res_model">matsafe.checkin</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No check-ins yet. Open the kiosk at /matsafe/kiosk</p>
        </field>
    </record>
</odoo>
