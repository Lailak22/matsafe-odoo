<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Icon of one report card (line icons, drawn with the text colour = the card's accent) -->
    <template id="report_icon" name="MatSafe: Report Card Icon">
        <svg class="mr-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <!-- skin: a patch with spots -->
            <t t-if="kind['key'] == 'skin'">
                <path d="M12 3c4.5 0 8 2.9 8 7.6 0 5-3.8 10.4-8 10.4s-8-5.4-8-10.4C4 5.9 7.5 3 12 3z"/>
                <path d="M9 10h.01M14.5 9h.01M13.5 14h.01"/>
            </t>
            <!-- sick: thermometer with heat lines -->
            <t t-elif="kind['key'] == 'sick'">
                <path d="M11 14.76V4.5a2.5 2.5 0 0 1 5 0v10.26a4.5 4.5 0 1 1-5 0z"/>
                <circle cx="13.5" cy="18" r="1.4"/>
                <path d="M13.5 16.5V9"/>
                <path d="M4 6.5h3M4 10.5h3M4 14.5h2"/>
            </t>
            <!-- injury: plaster -->
            <t t-elif="kind['key'] == 'injury'">
                <rect x="2.2" y="8.3" width="19.6" height="7.4" rx="3.7" transform="rotate(-45 12 12)"/>
                <rect x="9.2" y="9.2" width="5.6" height="5.6" rx="0.8" transform="rotate(-45 12 12)"/>
            </t>
            <!-- head knock: head with an impact star -->
            <t t-elif="kind['key'] == 'head'">
                <path d="M15.5 21v-3.2h2a1.5 1.5 0 0 0 1.5-1.5v-2.6l1.6-.8-1.6-3.4A7 7 0 1 0 8 15.4V21"/>
                <path d="M11 6.5l.8 1.9 2-.4-1 1.8 1.4 1.4-2 .1-.4 2-1.2-1.6-1.8 1 .4-2-1.7-1.1 2-.5z"/>
            </t>
            <!-- unsafe partner / incident: shield with an exclamation mark -->
            <t t-elif="kind['key'] == 'unsafe'">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M12 7.5v5"/>
                <circle cx="12" cy="16" r="1.1"/>
            </t>
            <!-- facility: wrench -->
            <path t-else="" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
    </template>

    <!-- Top of every report page: shield + wordmark + tagline, then the 3-step progress bar.
         progress_at: choose / details / send / done (report.js moves it on the form); empty: no bar.
         progress_labels: the 3 step names (default Choose / Details / Send). -->
    <template id="report_top" name="MatSafe: Report Page Top">
        <t t-set="step_labels" t-value="progress_labels or ['Choose', 'Details', 'Send']"/>
        <!-- Mat tape: the one red and black stripe of the page -->
        <div class="mr-tape" aria-hidden="true"/>
        <header class="mr-top">
            <a class="mr-logo" href="/matsafe/report">MatSafe</a>
            <p class="mr-tagline">Safe mats. Safe partners.</p>
        </header>
        <!-- Scoreboard steps: the red bar sits under the current one -->
        <ol t-if="progress_at" id="mr-progress" class="mr-progress" t-att-data-at="progress_at" aria-label="Progress">
            <li data-step="choose"><span class="mr-progress-label"><b>01</b> <t t-out="step_labels[0]"/></span><span class="mr-progress-bar"/></li>
            <li data-step="details"><span class="mr-progress-label"><b>02</b> <t t-out="step_labels[1]"/></span><span class="mr-progress-bar"/></li>
            <li data-step="send"><span class="mr-progress-label"><b>03</b> <t t-out="step_labels[2]"/></span><span class="mr-progress-bar"/></li>
        </ol>
    </template>

    <!-- Big round icon at the top of the thank-you and confirmation pages -->
    <template id="report_badge" name="MatSafe: Report Page Badge">
        <div t-attf-class="mr-badge #{badge == 'invalid' and 'mr-badge-muted' or ''}">
            <svg class="mr-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <!-- mail: waiting for the confirmation email -->
                <t t-if="badge == 'mail'">
                    <rect x="3" y="5" width="18" height="14" rx="2.5"/>
                    <polyline points="3.5 6.5 12 13 20.5 6.5"/>
                </t>
                <!-- shield: confirm your report -->
                <t t-elif="badge == 'shield'">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <polyline points="8.5 12 11 14.5 15.5 9.5"/>
                </t>
                <!-- invalid link -->
                <t t-elif="badge == 'invalid'">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 7.5v5.5"/>
                    <path d="M12 16.5v.01"/>
                </t>
                <polyline t-else="" points="20 6 9 17 4 12"/>
            </svg>
        </div>
    </template>

    <!-- /matsafe/report : public "Report something" page (mobile first).
         Standalone HTML like the kiosk: no website header/footer, own CSS and JS.
         The 6 cards and all their questions come from controllers/report_kinds.py.
         Step 1: pick a card. Step 2: report.js shows only that card's questions. Step 3: send. -->
    <template id="report_form" name="MatSafe: Report Form">&lt;!DOCTYPE html&gt;
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Report something | MatSafe</title>
        <link rel="stylesheet" t-attf-href="/matsafe/static/src/report.css?v=#{asset_version}"/>
    </head>
    <body>
        <t t-call="matsafe.report_top">
            <t t-set="progress_at" t-value="'details' if values.get('kind') else 'choose'"/>
        </t>

        <main class="mr-page">
            <h1 class="mr-title">Report something</h1>
            <p class="mr-lead">Tell us what is going on. It takes about a minute.</p>

            <!-- Problems found by the controller (missing answer, details not matched...) -->
            <div t-if="errors" class="mr-errors" role="alert">
                <p t-foreach="errors" t-as="error" t-out="error"/>
            </div>

            <!-- multipart: the facility card can send a photo. novalidate: report.js shows the problems. -->
            <form id="mr-form" action="/matsafe/report" method="post" enctype="multipart/form-data"
                  novalidate="novalidate">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <!-- Step 1: the cards. Each card is a radio button, so it also works with a keyboard. -->
                <fieldset class="mr-cards">
                    <legend class="mr-step">What do you want to report?</legend>
                    <label t-foreach="kinds" t-as="kind" class="mr-card">
                        <input type="radio" name="kind" t-att-value="kind['key']"
                               t-att-checked="values.get('kind') == kind['key']"
                               t-att-data-code="kind['needs_code'] and '1'"
                               t-att-data-consent="kind['needs_consent'] and '1'"/>
                        <span class="mr-card-icon"><t t-call="matsafe.report_icon"/></span>
                        <span class="mr-card-check" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2"
                                 stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span class="mr-card-text">
                            <span class="mr-card-title" t-out="kind['title']"/>
                            <span class="mr-card-arabic" lang="ar" dir="rtl" t-out="kind['arabic']"/>
                            <span class="mr-card-examples" t-out="kind['examples']"/>
                        </span>
                    </label>
                </fieldset>

                <!-- Step 2: shown once a card is picked -->
                <div class="mr-fill">
                    <button type="button" id="mr-change" class="mr-change">Choose something else</button>

                    <div class="mr-field" id="mr-code-field">
                        <label class="mr-label" for="mr-code">
                            Member code <span class="mr-optional mr-if-no-code">(optional)</span>
                        </label>
                        <input type="text" id="mr-code" name="member_code" class="mr-input" maxlength="40"
                               autocomplete="off" autocapitalize="characters"
                               t-att-value="values.get('member_code')"/>
                        <p class="mr-hint mr-if-code">Your name is never shown to training partners.</p>
                        <p class="mr-hint mr-if-no-code">Leave it empty to report without your name.</p>
                    </div>

                    <!-- One block of questions per card; report.js shows only the picked one -->
                    <section t-foreach="kinds" t-as="kind" class="mr-kind" t-att-data-kind="kind['key']">
                        <h2 class="mr-kind-title" t-out="kind['title']"/>
                        <p t-if="kind.get('note')" class="mr-note" t-out="kind['note']"/>

                        <t t-foreach="kind['fields']" t-as="field">
                            <!-- Input names are "<card>__<question>", e.g. skin__symptoms -->
                            <t t-set="input_name" t-value="'%s__%s' % (kind['key'], field['name'])"/>
                            <t t-set="value" t-value="values.get(input_name)"/>
                            <t t-set="widget" t-value="field['widget']"/>

                            <!-- Tick several (checks), pick one (choice) or 1 to 5 (scale): big buttons -->
                            <fieldset t-if="widget in ('checks', 'choice', 'scale')" class="mr-field"
                                      t-att-data-widget="widget" t-att-data-required="field['required'] and '1'">
                                <legend class="mr-label" t-out="field['label']"/>
                                <p t-if="field['hint']" class="mr-hint" t-out="field['hint']"/>
                                <div t-attf-class="mr-chips #{'mr-scale' if widget == 'scale' else ''}">
                                    <label t-foreach="field['options']" t-as="option" class="mr-chip">
                                        <input t-att-type="'checkbox' if widget == 'checks' else 'radio'"
                                               t-att-name="input_name" t-att-value="option"
                                               t-att-checked="(option in (value or [])) if widget == 'checks' else (value == option)"/>
                                        <span t-out="option"/>
                                    </label>
                                </div>
                            </fieldset>

                            <!-- Everything else: one input with a label -->
                            <div t-else="" class="mr-field"
                                 t-att-data-widget="widget" t-att-data-required="field['required'] and '1'">
                                <label class="mr-label" t-att-for="input_name" t-out="field['label']"/>
                                <input t-if="widget == 'date'" type="date" class="mr-input"
                                       t-att-id="input_name" t-att-name="input_name" t-att-value="value"/>
                                <input t-elif="widget == 'line'" type="text" class="mr-input" maxlength="120"
                                       t-att-id="input_name" t-att-name="input_name" t-att-value="value"/>
                                <textarea t-elif="widget == 'text'" class="mr-input" rows="4" maxlength="1000"
                                          t-att-id="input_name" t-att-name="input_name"><t t-out="value"/></textarea>
                                <!-- Class list: report.js adds the member's own classes before "Class not listed" -->
                                <select t-elif="widget == 'session'" class="mr-input mr-session"
                                        t-att-id="input_name" t-att-name="input_name" t-att-data-selected="value">
                                    <option value="">Choose a class</option>
                                    <option value="other" t-att-selected="value == 'other'">Class not listed</option>
                                </select>
                                <!-- A file cannot be kept when the form is shown again: the browser forbids it -->
                                <input t-elif="widget == 'photo'" type="file" class="mr-input mr-photo" accept="image/*"
                                       t-att-id="input_name" t-att-name="input_name"/>
                                <p t-if="widget == 'session'" class="mr-hint">
                                    Enter your member code to see your classes of the last 14 days.
                                </p>
                                <p t-if="field['hint']" class="mr-hint" t-out="field['hint']"/>
                            </div>
                        </t>
                    </section>

                    <div class="mr-field">
                        <label class="mr-label" for="mr-details">
                            Anything else? <span class="mr-optional">(optional)</span>
                        </label>
                        <textarea id="mr-details" name="details" class="mr-input" rows="3"
                                  maxlength="1000"><t t-out="values.get('details')"/></textarea>
                        <p class="mr-hint mr-if-consent">Only head coaches can read your answers.</p>
                    </div>

                    <!-- Consent: only for the four health cards -->
                    <div class="mr-field mr-if-consent" id="mr-consent-field">
                        <label class="mr-consent">
                            <input type="checkbox" id="mr-consent" name="consent" value="1"
                                   t-att-checked="values.get('consent')"/>
                            <span>I agree my report is used to protect my training partners anonymously</span>
                        </label>
                    </div>

                    <button type="submit" id="mr-submit" class="mr-submit">Send report</button>
                </div>
            </form>
        </main>

        <script t-attf-src="/matsafe/static/src/report.js?v=#{asset_version}"></script>
    </body>
</html>
    </template>

    <!-- Thank-you page, one text per card. `done` holds what the backend really did,
         so every sentence here is only shown when it is true. -->
    <template id="report_thanks" name="MatSafe: Report Sent">&lt;!DOCTYPE html&gt;
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Report sent | MatSafe</title>
        <link rel="stylesheet" t-attf-href="/matsafe/static/src/report.css?v=#{asset_version}"/>
    </head>
    <body>
        <t t-call="matsafe.report_top">
            <t t-set="progress_at" t-value="'done'"/>
        </t>

        <main class="mr-page mr-thanks">
            <t t-call="matsafe.report_badge">
                <t t-set="badge" t-value="'mail' if done.get('pending') else 'check'"/>
            </t>

            <!-- The report waits for the member's confirmation: nothing else has happened yet.
                 The wording also fits when no email arrives. -->
            <t t-if="done.get('pending')">
                <h1 class="mr-title">Almost done</h1>
                <p class="mr-lead">Your report is saved and waits for your confirmation.</p>
                <!-- Demo mode (system parameter matsafe.demo_mode = 1): the link of the email as a button -->
                <t t-if="done.get('demo_link')">
                    <a class="mr-submit mr-demo" t-att-href="done['demo_link']">Demo: open the confirmation email</a>
                    <p class="mr-text mr-demo-note">Demo mode: in real use this link only arrives by email.</p>
                </t>
                <p t-else="" class="mr-text">
                    Check your email to confirm your report. No email? Tell a coach, so they can confirm it for you.
                </p>
                <p class="mr-text">Nothing changes for you or your training partners until it is confirmed.</p>
                <p t-if="kind.get('note')" class="mr-note" t-out="kind['note']"/>
            </t>

            <!-- Cards 1 to 4 once the report is open (after the confirmation link):
                 its chain has run -->
            <t t-elif="kind['save_as'] == 'report'">
                <h1 class="mr-title">Thank you</h1>
                <t t-set="health" t-value="kind['key'] in ('skin', 'sick')"/>

                <p t-if="not health" class="mr-lead">
                    Your coach has been told. Take it easy and follow your coach's return-to-training advice.
                </p>

                <!-- Training partners: say what the chain really did -->
                <p t-if="done.get('contacts') and done.get('emailed')" class="mr-lead">
                    Your recent training partners have been alerted anonymously. They do not see your name.
                </p>
                <p t-elif="done.get('contacts')" class="mr-lead">
                    Your coaches now have a note to warn your recent training partners. Your name is not on it.
                </p>
                <p t-elif="health" class="mr-lead">We found no recent training partners to alert.</p>

                <!-- Door: read from the member after the report was saved -->
                <p t-if="done.get('door_paused')" class="mr-text">
                    Door check-in is paused for you until a head coach clears you.
                </p>
                <p t-else="" class="mr-text">You can still check in at the door.</p>

                <p t-if="health and done.get('door_paused')" class="mr-text">
                    Rest up. A head coach will clear you when you are ready to train again.
                </p>
                <p t-elif="health" class="mr-text">Rest up, and talk to a head coach before you train again.</p>

                <p t-if="kind.get('note')" class="mr-note" t-out="kind['note']"/>
            </t>

            <!-- Card 5: a task for the head coach -->
            <t t-elif="kind['save_as'] == 'coach_inbox'">
                <h1 class="mr-title">Thank you</h1>
                <p class="mr-lead">Only the head coach will see this.</p>
                <p class="mr-text">Nothing changes for your door check-in.</p>
            </t>

            <!-- Card 6: a task for the team -->
            <t t-else="">
                <h1 class="mr-title">Thanks!</h1>
                <p class="mr-lead">The team has been notified.</p>
                <p class="mr-text">Reference: <strong>#<t t-out="done.get('task_ref')"/></strong></p>
                <p t-if="done.get('photo')" class="mr-text">Your photo was attached.</p>
            </t>

            <a class="mr-submit mr-again" href="/matsafe/report">Report something else</a>
            <p class="mr-more"><a href="/matsafe/rate">Rate your training partners</a></p>
        </main>
    </body>
</html>
    </template>

    <!-- /matsafe/report/confirm/<token> : opened from the confirmation email.
         Opening the link changes nothing; the button sends a POST and that confirms the report.
         `kind` is empty when the link is wrong or was already used. -->
    <template id="report_confirm" name="MatSafe: Confirm Report">&lt;!DOCTYPE html&gt;
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <!-- The address of this page holds the token: keep it out of search engines and other sites -->
        <meta name="robots" content="noindex"/>
        <meta name="referrer" content="no-referrer"/>
        <title>Confirm your report | MatSafe</title>
        <link rel="stylesheet" t-attf-href="/matsafe/static/src/report.css?v=#{asset_version}"/>
    </head>
    <body>
        <t t-call="matsafe.report_top">
            <t t-set="progress_at" t-value="kind and 'send'"/>
        </t>

        <main class="mr-page mr-thanks">
            <t t-call="matsafe.report_badge">
                <t t-set="badge" t-value="'shield' if kind else 'invalid'"/>
            </t>
            <t t-if="kind">
                <h1 class="mr-title">Confirm your report</h1>
                <p class="mr-lead">You sent a report: <strong t-out="kind['title']"/>.</p>
                <p class="mr-text">
                    Tap the button to confirm it was you. The gym's safety rules for this report start
                    once you confirm.
                </p>

                <div t-if="error" class="mr-errors" role="alert">
                    <p t-out="error"/>
                </div>

                <form class="mr-confirm" t-attf-action="/matsafe/report/confirm/#{token}" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="mr-submit">Confirm my report</button>
                </form>

                <p class="mr-text">If you did not send this report, close this page and tell a coach.</p>
                <p t-if="kind.get('note')" class="mr-note" t-out="kind['note']"/>
            </t>
            <t t-else="">
                <h1 class="mr-title">This link is no longer valid</h1>
                <p class="mr-lead">If you already confirmed your report, there is nothing more to do.</p>
                <p class="mr-text">Otherwise please tell a coach in person.</p>
                <a class="mr-submit mr-again" href="/matsafe/report">Report something</a>
            </t>
        </main>
    </body>
</html>
    </template>

    <!-- /matsafe/rate : rate your training partners. Same brand as the report form (report.css).
         step: code (member code) -> class (one of their classes) -> rate (a score per partner).
         No JavaScript needed: every step is a normal POST, checked again by the server. -->
    <template id="rate_page" name="MatSafe: Rate Partners">&lt;!DOCTYPE html&gt;
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Rate your training partners | MatSafe</title>
        <link rel="stylesheet" t-attf-href="/matsafe/static/src/report.css?v=#{asset_version}"/>
    </head>
    <body>
        <t t-call="matsafe.report_top">
            <t t-set="progress_at" t-value="{'code': 'choose', 'class': 'details', 'rate': 'send'}[step]"/>
            <t t-set="progress_labels" t-value="rate_steps"/>
        </t>

        <main class="mr-page">
            <h1 class="mr-title">Rate your partners</h1>
            <p t-if="step == 'code'" class="mr-lead">How safely did your partners train with you? It takes a minute.</p>
            <!-- No name here: the page never confirms whose member code was typed -->
            <p t-if="step == 'class' and sessions" class="mr-lead">Pick the class you want to rate.</p>

            <div t-if="errors" class="mr-errors" role="alert">
                <p t-foreach="errors" t-as="error" t-out="error"/>
            </div>

            <!-- Step 1: who is rating -->
            <form t-if="step == 'code'" action="/matsafe/rate" method="post" novalidate="novalidate">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="step" value="code"/>
                <div class="mr-field">
                    <label class="mr-label" for="mr-code">Member code</label>
                    <input type="text" id="mr-code" name="member_code" class="mr-input" maxlength="40"
                           autocomplete="off" autocapitalize="characters" t-att-value="values.get('member_code')"/>
                    <p class="mr-hint">Your partners will never see who rated them.</p>
                </div>
                <button type="submit" class="mr-submit">Next</button>
            </form>

            <!-- Step 2: which class -->
            <t t-elif="step == 'class'">
                <form t-if="sessions" action="/matsafe/rate" method="post" novalidate="novalidate">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="step" value="class"/>
                    <input type="hidden" name="member_code" t-att-value="values.get('member_code')"/>
                    <fieldset class="mr-field">
                        <legend class="mr-label">Which class?</legend>
                        <p class="mr-hint">Your classes of the last 14 days, newest first.</p>
                        <div class="mr-options">
                            <label t-foreach="sessions" t-as="option" class="mr-option">
                                <input type="radio" name="session_id" t-att-value="option['id']"
                                       t-att-checked="values.get('session_id') == option['id']"/>
                                <span class="mr-option-title" t-out="option['label']"/>
                                <span class="mr-option-meta">
                                    <t t-if="option['partners'] == 1">1 partner</t>
                                    <t t-elif="option['partners']"><t t-out="option['partners']"/> partners</t>
                                    <t t-else="">No partners recorded</t>
                                </span>
                            </label>
                        </div>
                    </fieldset>
                    <button type="submit" class="mr-submit">Next</button>
                </form>
                <t t-else="">
                    <div class="mr-empty">
                        <h2 class="mr-empty-title">No recent classes</h2>
                        <p>We could not find a class you took part in during the last 14 days.
                           Once your coach records a class with you in it, you can rate your partners here.</p>
                    </div>
                    <a class="mr-submit mr-again" href="/matsafe/rate">Start again</a>
                </t>
            </t>

            <!-- Step 3: a score per partner -->
            <t t-else="">
                <p class="mr-lead">Class: <strong t-out="session_label"/></p>
                <!-- Back to the class list: a POST again, so the member code never goes in the address -->
                <form action="/matsafe/rate" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="step" value="code"/>
                    <input type="hidden" name="member_code" t-att-value="values.get('member_code')"/>
                    <button type="submit" class="mr-change">Choose another class</button>
                </form>

                <t t-if="partners">
                    <p class="mr-note">Your partner will never see who rated them.</p>
                    <form action="/matsafe/rate" method="post" novalidate="novalidate">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="step" value="save"/>
                        <input type="hidden" name="member_code" t-att-value="values.get('member_code')"/>
                        <input type="hidden" name="session_id" t-att-value="values.get('session_id')"/>

                        <section t-foreach="partners" t-as="info" class="mr-partner">
                            <t t-set="partner" t-value="info['partner']"/>
                            <div class="mr-partner-head">
                                <h2 class="mr-partner-name" t-out="partner.name"/>
                                <span t-if="info['rated']" class="mr-tag">Already rated</span>
                            </div>
                            <t t-if="not info['rated']">
                                <fieldset class="mr-field" data-widget="scale">
                                    <legend class="mr-label">Control and safety</legend>
                                    <p class="mr-hint">1 = too rough, 5 = very controlled</p>
                                    <div class="mr-chips mr-scale mr-scale-rate">
                                        <label t-foreach="['1', '2', '3', '4', '5']" t-as="score" class="mr-chip">
                                            <input type="radio" t-att-name="'score_%d' % partner.id" t-att-value="score"
                                                   t-att-checked="values.get('scores', {}).get(partner.id) == score"/>
                                            <span t-out="score"/>
                                        </label>
                                    </div>
                                </fieldset>
                                <div class="mr-field mr-field-last">
                                    <label class="mr-label" t-att-for="'comment_%d' % partner.id">
                                        Comment <span class="mr-optional">(optional)</span>
                                    </label>
                                    <input type="text" class="mr-input" maxlength="120"
                                           t-att-id="'comment_%d' % partner.id" t-att-name="'comment_%d' % partner.id"
                                           t-att-value="values.get('comments', {}).get(partner.id)"/>
                                </div>
                            </t>
                        </section>

                        <button t-if="open_count" type="submit" class="mr-submit">Send ratings</button>
                        <p t-else="" class="mr-lead">You have rated everyone from this class. Thank you!</p>
                    </form>
                </t>
                <div t-else="" class="mr-empty">
                    <h2 class="mr-empty-title">No partners recorded</h2>
                    <p>Your coach did not record who you trained with in this class, so there is no one to rate.
                       Choose another class, or ask your coach to add the pairings.</p>
                </div>
            </t>
        </main>
    </body>
</html>
    </template>

    <!-- Thank-you page of /matsafe/rate. `done` holds only a count and the class: no names. -->
    <template id="rate_thanks" name="MatSafe: Ratings Sent">&lt;!DOCTYPE html&gt;
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Ratings sent | MatSafe</title>
        <link rel="stylesheet" t-attf-href="/matsafe/static/src/report.css?v=#{asset_version}"/>
    </head>
    <body>
        <t t-call="matsafe.report_top">
            <t t-set="progress_at" t-value="'done'"/>
            <t t-set="progress_labels" t-value="rate_steps"/>
        </t>

        <main class="mr-page mr-thanks">
            <t t-call="matsafe.report_badge">
                <t t-set="badge" t-value="'check'"/>
            </t>
            <h1 class="mr-title">Thank you</h1>
            <p class="mr-lead">
                <t t-if="done.get('count') == 1">Your rating</t><t t-else="">Your <t t-out="done.get('count')"/> ratings</t>
                for <strong t-out="done.get('session')"/> <t t-if="done.get('count') == 1">was</t><t t-else="">were</t> saved.
            </p>
            <p class="mr-text">Your partner will never see who rated them. Coaches use ratings to keep sparring safe.</p>
            <a class="mr-submit mr-again" href="/matsafe/rate">Rate another class</a>
            <p class="mr-more"><a href="/matsafe/report">Report something</a></p>
        </main>
    </body>
</html>
    </template>

    <!-- ===== Door kiosk and pairing camera: shared pieces (styles in kiosk.css) ===== -->

    <!-- Mat tape, MATSAFE wordmark and the screen's label (screen_label) -->
    <template id="ms_screen_top" name="MatSafe: Kiosk Screen Top">
        <div class="ms-tape" aria-hidden="true"/>
        <header class="ms-top">
            <span class="ms-logo">MatSafe</span>
            <span class="ms-screen-label" t-out="screen_label"/>
        </header>
    </template>

    <!-- The webcam frame. The JS puts its canvas into #ms-camera; until then (no model,
         no camera) the frame shows "Camera off" and no SCANNING tag. -->
    <template id="ms_camera_frame" name="MatSafe: Kiosk Camera Frame">
        <div class="ms-frame">
            <div id="ms-camera" class="ms-camera"></div>
            <span class="ms-scan-tag"><i class="ms-dot" aria-hidden="true"></i>Scanning</span>
            <div class="ms-camera-off" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 16v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2m5.66 0H14a2 2 0 0 1 2 2v3.34l1 1L23 7v10"/>
                    <line x1="1" y1="1" x2="23" y2="23"/>
                </svg>
                <span>Camera off</span>
            </div>
        </div>
    </template>

    <!-- Full-screen result: the JS sets the colour class and fills the title and the detail -->
    <template id="ms_result_screen" name="MatSafe: Kiosk Result Screen">
        <div id="ms-result" class="ms-result" role="alert" hidden="hidden">
            <svg class="ms-result-icon ms-icon-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
            <svg class="ms-result-icon ms-icon-stop" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
                <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <div id="ms-result-text" class="ms-result-text"></div>
            <div id="ms-result-detail" class="ms-result-detail"></div>
            <!-- Green screen only: "RETURN TO PLAY: DRILLING ONLY" (empty = hidden) -->
            <div id="ms-result-banner" class="ms-result-banner"></div>
        </div>
    </template>

    <!-- /matsafe/kiosk : full-screen door page. Standalone HTML: no website header/footer.
         JS, CSS and the two libraries are plain static files (the libraries are local copies,
         so the kiosk works without internet). -->
    <template id="kiosk" name="MatSafe: Door Kiosk">&lt;!DOCTYPE html&gt;
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>MatSafe Kiosk</title>
        <link rel="stylesheet" t-attf-href="/matsafe/static/src/kiosk.css?v=#{asset_version}"/>
    </head>
    <body class="ms-kiosk">
        <t t-call="matsafe.ms_screen_top">
            <t t-set="screen_label" t-value="'Door check-in'"/>
        </t>

        <main class="ms-main">
            <t t-call="matsafe.ms_camera_frame"/>
            <p id="ms-status" class="ms-status">Starting...</p>
        </main>

        <!-- Fallback: type the member code -->
        <form id="ms-code-form" class="ms-code" autocomplete="off">
            <label for="ms-code-input">Or enter your member code</label>
            <div class="ms-code-row">
                <input id="ms-code-input" type="text" name="member_code" autocapitalize="characters"/>
                <button type="submit">Check in</button>
            </div>
        </form>

        <t t-call="matsafe.ms_result_screen"/>

        <script src="/matsafe/static/src/lib/tf.min.js"></script>
        <script src="/matsafe/static/src/lib/teachablemachine-image.min.js"></script>
        <script t-attf-src="/matsafe/static/src/kiosk.js?v=#{asset_version}"></script>
    </body>
</html>
    </template>

    <!-- /matsafe/pair-cam?session_id=ID : a coach pairs two members with the camera.
         Same look, libraries and face model as the kiosk. -->
    <template id="pair_cam" name="MatSafe: Pair by Camera">&lt;!DOCTYPE html&gt;
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>MatSafe Pairing</title>
        <link rel="stylesheet" t-attf-href="/matsafe/static/src/kiosk.css?v=#{asset_version}"/>
    </head>
    <!-- pair_cam.js reads the session id from here -->
    <body class="ms-pair" t-att-data-session-id="pair_session.id or ''">
        <t t-call="matsafe.ms_screen_top">
            <t t-set="screen_label" t-value="'Pairing camera'"/>
        </t>

        <main class="ms-main">
            <h1 class="ms-session">
                <t t-if="pair_session">Pairing: <t t-out="pair_session.name"/></t>
                <t t-else="">No session selected</t>
            </h1>
            <!-- Scoreboard: pair_cam.js moves data-at from 1 to 2 -->
            <ol id="ms-steps" class="ms-steps" data-at="1" aria-label="Step">
                <li data-step="1"><b>01</b> Partner 1</li>
                <li data-step="2"><b>02</b> Partner 2</li>
            </ol>
            <div class="ms-stage">
                <t t-call="matsafe.ms_camera_frame"/>
                <!-- Partner 1's name tag, or a short message (pair_cam.js) -->
                <p id="ms-partner" class="ms-partner"></p>
            </div>
            <p id="ms-status" class="ms-status">Starting...</p>
        </main>

        <t t-call="matsafe.ms_result_screen"/>

        <script src="/matsafe/static/src/lib/tf.min.js"></script>
        <script src="/matsafe/static/src/lib/teachablemachine-image.min.js"></script>
        <script t-attf-src="/matsafe/static/src/pair_cam.js?v=#{asset_version}"></script>
    </body>
</html>
    </template>
</odoo>
