<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_matsafe" model="res.groups.privilege">
        <field name="name">MatSafe</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_coach" model="res.groups">
        <field name="name">Coach</field>
        <field name="comment">Sees sessions, pairings, check-ins and gear.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_matsafe"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_head_coach" model="res.groups">
        <field name="name">Head Coach</field>
        <field name="comment">Everything a coach can do, plus reading member self-report descriptions.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_matsafe"/>
        <field name="implied_ids" eval="[(4, ref('group_coach'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
